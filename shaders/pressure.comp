#version 450
layout(local_size_x = 16, local_size_y = 16) in;
layout(push_constant) uniform Push {
    float dt;
    float inflow;
    float obstacleX;
    float obstacleY;
    float obstacleRadius;
    float gain;
    int   view;
    float windowWidth;
    float windowHeight;
    float viscosity;
    float dyeStripe;
    int   reset;
    int   palette;
} pc;

layout(rgba16f, binding = 0) uniform readonly  image2D uPressure;
layout(rgba16f, binding = 1) uniform readonly  image2D uDivergence;
layout(rgba16f, binding = 2) uniform writeonly image2D uPressureOut;

bool isSolid(vec2 cellCentre) {
    return distance(cellCentre, vec2(pc.obstacleX, pc.obstacleY)) < pc.obstacleRadius;
}

// Pressure of a neighbour cell
float pressureAt(ivec2 cell, float centre, ivec2 size) {
    if (cell.x >= size.x) return 0.0;                     // outflow edge: pressure fixed to 0
    cell = clamp(cell, ivec2(0), size - 1);               // other walls: copy the edge cell
    if (isSolid(vec2(cell) + 0.5)) return centre;         // obstacle: zero gradient
    return imageLoad(uPressure, cell).x;
}

void main() {
    ivec2 id = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(uPressureOut);
    if (any(greaterThanEqual(id, size))) return;

    // Restart: clear the pressure (every sweep of this frame writes zero)
    if (pc.reset != 0) {
        imageStore(uPressureOut, id, vec4(0.0));
        return;
    }

    float centre = imageLoad(uPressure, id).x;
    float neighbours = pressureAt(id + ivec2(1, 0), centre, size)
                     + pressureAt(id - ivec2(1, 0), centre, size)
                     + pressureAt(id + ivec2(0, 1), centre, size)
                     + pressureAt(id - ivec2(0, 1), centre, size);

    float divergence = imageLoad(uDivergence, id).x;
    float pressure = (neighbours - divergence) * 0.25;
    imageStore(uPressureOut, id, vec4(pressure, 0.0, 0.0, 0.0));
}
