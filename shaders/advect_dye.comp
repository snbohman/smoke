#version 450
layout(local_size_x = 16, local_size_y = 16) in;
layout(push_constant) uniform Push {
    float dt;
    float inflow;
    float obstacleX;
    float obstacleY;
    float obstacleRadius;
    float gain;
    int   view;
    float windowWidth;
    float windowHeight;
    float viscosity;
    float dyeStripe;
    int   reset;
    int   palette;
} pc;

layout(binding = 0) uniform sampler2D uVelocity;
layout(binding = 1) uniform sampler2D uDye;
layout(rgba16f, binding = 2) uniform writeonly image2D uDyeOut;
bool isSolid(vec2 cellCentre) {
    return distance(cellCentre, vec2(pc.obstacleX, pc.obstacleY)) < pc.obstacleRadius;
}

void main() {
    ivec2 id = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(uDyeOut);
    if (any(greaterThanEqual(id, size))) return;

    // Restart: no dye
    if (pc.reset != 0) {
        imageStore(uDyeOut, id, vec4(0.0));
        return;
    }

    vec2 cellCentre = vec2(id) + 0.5;
    vec2 velocity = texelFetch(uVelocity, id, 0).xy;
    vec2 departure = cellCentre - pc.dt * velocity;
    vec4 dye = texture(uDye, departure / vec2(size));

    // Source: stripes (dyeStripe cells on, dyeStripe cells off) injected at the inflow edge
    if (id.x < 4) dye = vec4(mod(floor(cellCentre.y / max(pc.dyeStripe, 1.0)), 2.0));

    if (isSolid(cellCentre)) dye = vec4(0.0);
    imageStore(uDyeOut, id, dye);
}
