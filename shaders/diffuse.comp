#version 450

layout(local_size_x = 16, local_size_y = 16) in;

layout(rgba16f, set = 0, binding = 0) uniform readonly image2D src;
layout(rgba16f, set = 0, binding = 1) uniform writeonly image2D dst;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(src);

    if (any(greaterThanEqual(p, size)))
        return;

    ivec2 hi = size - 1;

    vec4 center = imageLoad(src, p);

    vec4 neighbors =
          imageLoad(src, clamp(p + ivec2( 1,  0), ivec2(0), hi))
        + imageLoad(src, clamp(p + ivec2(-1,  0), ivec2(0), hi))
        + imageLoad(src, clamp(p + ivec2( 0,  1), ivec2(0), hi))
        + imageLoad(src, clamp(p + ivec2( 0, -1), ivec2(0), hi));

    // Slightly stronger diffusion than the original.
    vec4 result = mix(center, neighbors * 0.25, 1);

    // Heat source
    vec2 centerPos = vec2(size) * 0.5;

    if (distance(vec2(p), centerPos) < 12.0)
        result = vec4(1.0);

    imageStore(dst, p, result);
}
