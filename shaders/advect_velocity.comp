#version 450
layout(local_size_x = 16, local_size_y = 16) in;

#define OBSTACLE_BINDING 3
#include "common.glsl"

layout(binding = 0) uniform sampler2D uVelocity;
layout(rgba16f, binding = 1) uniform writeonly image2D uVelocityOut;
layout(rgba16f, binding = 2) uniform writeonly image2D uSourceOut;

// Deterministic trigger for shedding: a transverse acceleration (U^2/D units) in the near
// wake, even in y so it breaks the mirror symmetry of the flow. Acts for SEED_DURATION D/U
float seedAcceleration(vec2 cellCentre) {
    float diameter = 2.0 * pc.obstacleRadius;
    if (pc.time * pc.inflow / diameter >= SEED_DURATION) return 0.0;

    vec2 centre = vec2(pc.obstacleX + 1.5 * pc.obstacleRadius, pc.obstacleY);
    vec2 d = (cellCentre - centre) / pc.obstacleRadius;
    return pc.perturbation * pc.inflow * pc.inflow / diameter * exp(-dot(d, d));
}

void main() {
    ivec2 id = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(uVelocityOut);
    if (any(greaterThanEqual(id, size))) return;

    vec2 cellCentre = vec2(id) + 0.5;
    vec2 advected;

    if (pc.reset != 0) {
        // Restart: uniform flow at the inflow speed
        advected = vec2(pc.inflow, 0.0);
    } else {
        // Walk backwards along the flow and read what was there (bilinear)
        vec2 velocity = texelFetch(uVelocity, id, 0).xy;
        vec2 departure = cellCentre - pc.dt * velocity;
        advected = texture(uVelocity, departure / vec2(size)).xy;
    }

    advected.y += pc.dt * seedAcceleration(cellCentre);
    advected = applyVelocityBC(advected, id, size);

    imageStore(uVelocityOut, id, vec4(advected, 0.0, 0.0));
    imageStore(uSourceOut, id, vec4(advected, 0.0, 0.0));          // right-hand side of the viscosity solve
}
