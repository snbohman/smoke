#version 450
layout(local_size_x = 16, local_size_y = 16) in;
layout(push_constant) uniform Push {
    float dt;
    float inflow;
    float obstacleX;
    float obstacleY;
    float obstacleRadius;
    float gain;
    int   view;
    float windowWidth;
    float windowHeight;
} pc;

layout(binding = 0) uniform sampler2D uVelocity;
layout(rgba16f, binding = 1) uniform readonly  image2D uPressure;
layout(rgba16f, binding = 2) uniform writeonly image2D uVelocityOut;

bool isSolid(vec2 cellCentre) {
    return distance(cellCentre, vec2(pc.obstacleX, pc.obstacleY)) < pc.obstacleRadius;
}

// Same neighbour rules as in pressure.comp
float pressureAt(ivec2 cell, float centre, ivec2 size) {
    if (cell.x >= size.x) return 0.0;
    cell = clamp(cell, ivec2(0), size - 1);
    if (isSolid(vec2(cell) + 0.5)) return centre;
    return imageLoad(uPressure, cell).x;
}

void main() {
    ivec2 id = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(uVelocityOut);
    if (any(greaterThanEqual(id, size))) return;

    float centre = imageLoad(uPressure, id).x;
    float right = pressureAt(id + ivec2(1, 0), centre, size);
    float left  = pressureAt(id - ivec2(1, 0), centre, size);
    float up    = pressureAt(id + ivec2(0, 1), centre, size);
    float down  = pressureAt(id - ivec2(0, 1), centre, size);

    vec2 gradient = 0.5 * vec2(right - left, up - down);
    vec2 velocity = texelFetch(uVelocity, id, 0).xy - gradient;

    if (isSolid(vec2(id) + 0.5)) velocity = vec2(0.0);
    if (id.y == 0 || id.y == size.y - 1) velocity.y = 0.0;
    if (id.x == 0) velocity = vec2(pc.inflow, 0.0);

    imageStore(uVelocityOut, id, vec4(velocity, 0.0, 0.0));
}
